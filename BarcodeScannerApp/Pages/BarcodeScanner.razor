@page "/barcode-scanner"
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="barcode-page">

    <!-- HEADER -->
    <div class="scanner-header">
        <div>
            <h3>Barcode Scanner</h3>
            <p>Scan barcode using Camera or Hardware Scanner</p>
        </div>

        <div class="unique-counter">
            <span>Unique Items</span>
            <strong>@scannedItems.Count</strong>
        </div>
    </div>


    <!-- SCANNER SECTION -->
    <div class="scanner-card">

        <div class="scanner-card-header">
            <div>
                <h5>Barcode Scanner</h5>
                <small>
                    Scan a barcode. Duplicate barcodes will not be added again.
                </small>
            </div>

            <div class="scanner-buttons">

                @if (!isCameraOpen)
                {
                    <button class="btn btn-primary"
                            @onclick="OpenCameraAsync">
                        📷 Open Camera
                    </button>
                }
                else
                {
                    <button class="btn btn-warning"
                            @onclick="StopCameraAsync">
                        ⏹ Stop Camera
                    </button>
                }

                <button class="btn btn-outline-primary"
                        @onclick="FocusHardwareInputAsync">
                    ⌨ Hardware Scanner
                </button>

            </div>
        </div>


        <!-- CAMERA - INLINE, NO POPUP -->
        <div class="camera-section">

            <div class="camera-title">
                <span class="camera-dot @(isCameraOpen ? "active" : "")"></span>

                @if (isCameraOpen)
                {
                    <span>Camera Scanner Active</span>
                }
                else
                {
                    <span>Camera Scanner Stopped</span>
                }
            </div>

            <div id="barcodeCamera"
                 class="barcode-camera @(isCameraOpen ? "camera-active" : "")">

                @if (!isCameraOpen)
                {
                    <div class="camera-placeholder">
                        <div class="camera-icon">📷</div>
                        <div>Camera scanner is stopped</div>
                        <small>Click "Open Camera" to start scanning</small>
                    </div>
                }

            </div>

        </div>


        <!-- STATUS -->
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="scan-status @statusClass">
                <div class="status-icon">
                    @statusIcon
                </div>

                <div>
                    <strong>@statusTitle</strong>
                    <div>@message</div>
                </div>
            </div>
        }


        <!-- HARDWARE SCANNER -->
        <div class="hardware-section">

            <label>
                Hardware Scanner
            </label>

            <input id="hardwareBarcodeInput"
                   class="form-control"
                   placeholder="Click here and scan using USB / Bluetooth scanner"
                   @bind="hardwareBarcode"
                   @bind:event="oninput"
                   @onkeydown="HardwareScannerKeyDown" />

            <small>
                Scanner should send ENTER after barcode.
            </small>

        </div>

    </div>


    <!-- SCANNED LIST -->
    <div class="list-card">

        <div class="list-header">

            <div>
                <h4>Scanned Products</h4>
                <span>
                    Only unique barcodes are shown
                </span>
            </div>

            <div class="total-badge">
                Total Unique: @scannedItems.Count
            </div>

        </div>


        @if (scannedItems.Count == 0)
        {
            <div class="empty-list">

                <div class="empty-icon">
                    📦
                </div>

                <h5>No Barcode Scanned</h5>

                <p>
                    Start the camera or use your hardware scanner.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="barcode-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Barcode</th>
                            <th>Quantity</th>
                            <th>Last Scan Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in scannedItems.Select((x, index) => new { x, index }))
                        {
                            <tr class="unique-row">

                                <td>
                                    <span class="row-number">
                                        @(item.index + 1)
                                    </span>
                                </td>

                                <td>
                                    <strong class="barcode-value">
                                        @item.x.Barcode
                                    </strong>
                                </td>

                                <td>
                                    <span class="quantity-badge">
                                        1
                                    </span>
                                </td>

                                <td>
                                    @item.x.LastScanTime.ToString("HH:mm:ss")
                                </td>

                                <td>
                                    <span class="success-badge">
                                        ✓ UNIQUE
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


@code {

    private bool isCameraOpen;

    private string hardwareBarcode = "";

    private string message = "";

    private string statusClass = "";

    private string statusTitle = "";

    private string statusIcon = "";

    private DotNetObjectReference<BarcodeScanner>? dotNetReference;

    private List<ScannedItem> scannedItems = new();


    // =========================================================
    // STEP 1 - OPEN CAMERA
    // =========================================================

    private async Task OpenCameraAsync()
    {
        message = "";
        statusClass = "";

        isCameraOpen = true;

        dotNetReference ??=
            DotNetObjectReference.Create(this);

        StateHasChanged();

        await Task.Delay(200);

        await JS.InvokeVoidAsync(
            "barcodeScanner.start",
            dotNetReference);
    }


    // =========================================================
    // STEP 2 - STOP CAMERA
    // =========================================================

    private async Task StopCameraAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "barcodeScanner.stop");
        }
        catch
        {
        }

        isCameraOpen = false;

        message = "Camera scanner stopped.";

        statusTitle = "STOPPED";
        statusIcon = "⏹";
        statusClass = "status-warning";

        StateHasChanged();
    }


    // =========================================================
    // STEP 3 - HARDWARE SCANNER
    // =========================================================

    private async Task FocusHardwareInputAsync()
    {
        await JS.InvokeVoidAsync(
            "barcodeScanner.focusHardwareInput");
    }


    private async Task HardwareScannerKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var barcode = hardwareBarcode?.Trim();

            hardwareBarcode = "";

            if (string.IsNullOrWhiteSpace(barcode))
            {
                await ScanFailedAsync(
                    "No barcode detected.");
                return;
            }

            await AddBarcodeAsync(barcode);
        }
    }


    // =========================================================
    // STEP 4 - CAMERA BARCODE DETECTED
    // =========================================================

    [JSInvokable]
    public async Task BarcodeDetected(string barcode)
    {
        await AddBarcodeAsync(barcode);
    }


    // =========================================================
    // STEP 5 - ADD ONLY UNIQUE BARCODE
    // =========================================================

    private async Task AddBarcodeAsync(string barcode)
    {
        barcode = barcode?.Trim() ?? "";

        // -----------------------------------------
        // EMPTY BARCODE = FAILED
        // -----------------------------------------

        if (string.IsNullOrWhiteSpace(barcode))
        {
            await ScanFailedAsync(
                "Barcode is empty or invalid.");

            return;
        }


        // -----------------------------------------
        // CHECK DUPLICATE
        // -----------------------------------------

        bool alreadyExists =
            scannedItems.Any(x =>
                string.Equals(
                    x.Barcode,
                    barcode,
                    StringComparison.OrdinalIgnoreCase));


        // -----------------------------------------
        // DUPLICATE BARCODE
        // -----------------------------------------

        if (alreadyExists)
        {
            message =
                $"Barcode {barcode} already scanned. Duplicate ignored.";

            statusTitle = "REPEAT";
            statusIcon = "↻";
            statusClass = "status-repeat";

            await JS.InvokeVoidAsync(
                "barcodeScanner.playRepeatSound");

            StateHasChanged();

            return;
        }


        // -----------------------------------------
        // UNIQUE BARCODE
        // -----------------------------------------

        scannedItems.Insert(
            0,
            new ScannedItem
            {
                Barcode = barcode,
                Quantity = 1,
                LastScanTime = DateTime.Now
            });


        message =
            $"Barcode {barcode} scanned successfully.";

        statusTitle = "SUCCESS";
        statusIcon = "✓";
        statusClass = "status-success";


        // SUCCESS SOUND

        await JS.InvokeVoidAsync(
            "barcodeScanner.playSuccessSound");


        StateHasChanged();
    }


    // =========================================================
    // STEP 6 - FAILED SCAN
    // =========================================================

    private async Task ScanFailedAsync(string error)
    {
        message = error;

        statusTitle = "FAILED";
        statusIcon = "✕";
        statusClass = "status-failed";


        await JS.InvokeVoidAsync(
            "barcodeScanner.playFailedSound");


        StateHasChanged();
    }


    // =========================================================
    // STEP 7 - CAMERA ERROR
    // =========================================================

    [JSInvokable]
    public async Task ScannerError(string error)
    {
        await ScanFailedAsync(
            $"Scanner error: {error}");
    }


    // =========================================================
    // STEP 8 - DISPOSE
    // =========================================================

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "barcodeScanner.stop");
        }
        catch
        {
        }

        dotNetReference?.Dispose();
    }


    // =========================================================
    // MODEL
    // =========================================================

    private class ScannedItem
    {
        public string Barcode { get; set; } = "";

        public int Quantity { get; set; } = 1;

        public DateTime LastScanTime { get; set; }
    }
}